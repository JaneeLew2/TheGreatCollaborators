assessment_questions = {
    "Data Privacy": [
        "Does the organization have a documented data privacy policy?",
        "Is sensitive data identified and classified?",
        "Are users informed about how their data is collected and used?"
    ],

    "Data Governance": [
        "Does the organization have defined data owners?",
        "Are data governance responsibilities clearly assigned?",
        "Are there policies for managing data throughout its lifecycle?"
    ],

    "Compliance": [
        "Does the organization regularly review compliance requirements?",
        "Are compliance audits performed?",
        "Are regulatory requirements documented?"
    ],

    "Security": [
        "Is access to sensitive data restricted?",
        "Is multi-factor authentication used?",
        "Are security incidents documented and reviewed?"
    ],

    "Automation": [
        "Are governance processes automated when possible?",
        "Are automated alerts used for policy violations?",
        "Are compliance reports generated automatically?"
    ]
}


def display_questions():
    for category, questions in assessment_questions.items():
        print(f"\n{category}")

        for number, question in enumerate(questions, start=1):
            print(f"{number}. {question}")


if __name__ == "__main__":
    display_questions()
